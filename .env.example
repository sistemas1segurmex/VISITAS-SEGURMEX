# Copia este archivo a ".env" y rellena la contraseña real de Supabase.
# Es el MISMO proyecto Supabase que usa el ERP — las tablas de esta app viven
# en el esquema "visitas" (separadas del ERP, que usa "public").
SUPABASE_DB_HOST=aws-1-us-west-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.TU_PROJECT_REF
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=PON_AQUI_TU_PASSWORD
DB_SCHEMA=visitas

# Clave de Google Maps (opcional) para el buscador de calles al registrar
# clientes. Sin ella se usa OpenStreetMap. En Google Cloud: habilitar
# "Maps JavaScript API" y "Places API (New)", y restringir la clave por
# referente HTTP al dominio de la app.
GOOGLE_MAPS_API_KEY=

# Pruebas E2E (Playwright, tests/e2e). Un vendedor de prueba de la BD de
# desarrollo -- nunca uno real ni la BD de producción.
E2E_VISITAS_URL=http://localhost/visitas/
E2E_VISITAS_EMAIL=
E2E_VISITAS_PASSWORD=

# Correo (avisos de muestras, invitaciones). Mismas variables que el ERP.
# MAIL_ENCRYPTION=ssl para puerto 465; vacío o tls para 587 (STARTTLS).
MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Segurmex
