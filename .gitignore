# Credenciales — nunca subir
.env

# Fotos de evidencia subidas por los vendedores (datos reales, no código)
uploads/checkins/*
!uploads/checkins/.gitkeep

# Fotos de perfil de usuarios (datos reales, no código)
uploads/usuarios/*
!uploads/usuarios/.gitkeep

# Caché de geocodificación (nombreLugarGPS en includes/helpers.php) — datos
# generados en tiempo de ejecución, no código.
uploads/cache/*
!uploads/cache/.gitkeep

# Basura de sistema
.DS_Store
Thumbs.db
